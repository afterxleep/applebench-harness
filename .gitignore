.build/
.applebench/
*.profraw
.DS_Store
site/_site/
site/.jekyll-cache/
dist/

# Per-task logs, beside the results they explain. Regenerated by every run,
# far larger than the reports, and reproducible from the run directories.
Reports/Logs/

# A run's own bookkeeping. What the harness built, what it printed, and
# which tasks it had left to do: rewritten by every run, and none of it a
# result. summary.csv and summary.json are the report.
prepare.log
run.log
pending-suite.yaml

# A run's exports. The published copies under site/_data are what the site
# reads; these are the working ones, rewritten by every run.
Reports/*/summary.csv
Reports/*/summary.json
